# Copia a .env y rellena los valores reales

# Kimi API (proveedor principal de LLM para planificación)
KIMI_API_KEY=sk-...

# GitHub (token clásico con scopes repo, admin:org_hook, admin:repo_hook)
GITHUB_TOKEN=ghp_...

# Jules API (para invocar a Jules directamente)
JULES_API_KEY=

# Webhook GitHub
GITHUB_WEBHOOK_SECRET=genera-un-secreto-largo-aleatorio
WEBHOOK_PORT=8644
WEBHOOK_PUBLIC_URL=https://tu-dominio-o-ip:8644

# Telegram
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxyz
# Tu chat ID de Telegram (obtenlo de https://api.telegram.org/bot<TOKEN>/getUpdates)
ADMIN_TELEGRAM_CHAT_ID=123456789
# IDs de usuarios permitidos, separados por comas. Usa '*' para permitir todos (no recomendado).
TELEGRAM_ALLOWED_USERS=123456789
# Canal por defecto para notificaciones (opcional)
TELEGRAM_HOME_CHANNEL=
TELEGRAM_HOME_CHANNEL_NAME=

# Home de Hermes
HERMES_HOME=/var/lib/hermes
