# === Kimi API ===
KIMI_API_KEY=sk-kimi-...

# === GitHub ===
# Token con scope 'repo' (y read:org para gh auth login).
# Fine-grained PAT recomendado; classic PAT también funciona.
GITHUB_TOKEN=ghp_...

# Secreto compartido para validar HMAC de webhooks de GitHub.
GITHUB_WEBHOOK_SECRET=genera-un-secreto-largo-aleatorio

# === Hermes / Gateway ===
HERMES_HOME=/var/lib/hermes
WEBHOOK_PORT=8644
# URL pública donde GitHub llegará a los webhooks (sin barra final).
WEBHOOK_PUBLIC_URL=https://mfcodev.x5servers.cloud:8644

# === WhatsApp (Baileys bridge) ===
WHATSAPP_ENABLED=true
# 'bot' para número dedicado, 'self-chat' para usar tu propio número.
WHATSAPP_MODE=bot
# Número(s) permitidos, con código de país y sin '+' ni espacios.
# Usa '*' para permitir todos (NO recomendado en producción).
WHATSAPP_ALLOWED_USERS=584120787255

# === Admin ===
# Número del admin para notificaciones de issues/PRs.
ADMIN_WHATSAPP_NUMBER=584120787255
