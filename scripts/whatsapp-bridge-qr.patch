+// --- QR web server helpers --------------------------------------------------
+const QR_WEB_PORT = parseInt(process.env.WHATSAPP_QR_WEB_PORT || '8080', 10);
+const QR_DIR = path.join(process.env.HERMES_HOME || process.env.HOME || '.', 'platforms', 'whatsapp');
+const QR_PNG_PATH = path.join(QR_DIR, 'qr.png');
+const QR_STATUS_PATH = path.join(QR_DIR, 'qr-status.json');
+
+function ensureQrDir() {
+  try {
+    if (!existsSync(QR_DIR)) mkdirSync(QR_DIR, { recursive: true });
+  } catch (err) {
+    console.error('Failed to create QR directory:', err.message);
+  }
+}
+
+function writeQrStatus(status, extra = {}) {
+  try {
+    ensureQrDir();
+    const payload = { status, updatedAt: new Date().toISOString(), ...extra };
+    writeFileSync(QR_STATUS_PATH, JSON.stringify(payload, null, 2));
+  } catch (err) {
+    console.error('Failed to write QR status:', err.message);
+  }
+}
+
+async function saveQrImage(qrText) {
+  try {
+    ensureQrDir();
+    await qrcode.toFile(QR_PNG_PATH, qrText, {
+      type: 'png',
+      width: 400,
+      margin: 2,
+      color: { dark: '#000000', light: '#ffffff' },
+    });
+    writeQrStatus('pending', { qrPath: QR_PNG_PATH });
+  } catch (err) {
+    console.error('Failed to save QR image:', err.message);
+    writeQrStatus('error', { error: err.message });
+  }
+}
+
+function clearQrImage() {
+  try {
+    if (existsSync(QR_PNG_PATH)) unlinkSync(QR_PNG_PATH);
+    writeQrStatus('connected');
+  } catch (err) {
+    console.error('Failed to clear QR image:', err.message);
+  }
+}
+
